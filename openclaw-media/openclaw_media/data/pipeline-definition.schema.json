{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "pipeline_id",
    "version",
    "min_cli_version",
    "display_name",
    "description",
    "capability_id",
    "input_schema",
    "nodes",
    "model_requirements",
    "output_allowlist",
    "retention_policy",
    "redaction_policy"
  ],
  "properties": {
    "pipeline_id": {
      "type": "string",
      "pattern": "^media\\.[a-z.]+\\.v1$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "min_cli_version": {
      "type": "string"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "input_schema": {
      "type": "object"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "type",
          "version",
          "outputs"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "model_requirements": {
      "type": "array"
    },
    "output_allowlist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "mime_types",
          "max_bytes",
          "upload",
          "default_selected"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "mime_types": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "upload": {
            "enum": [
              "content",
              "descriptor_only",
              "forbidden"
            ]
          },
          "default_selected": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "retention_policy": {
      "type": "object"
    },
    "redaction_policy": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
