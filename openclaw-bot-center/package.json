    "lint": "oxlint src scripts --ignore-pattern 'dist/**' --ignore-pattern 'dist-media/**'",
    "preview": "vite preview --host 0.0.0.0",
    "dev:demo": "vite --config vite.demo.config.ts --host 0.0.0.0",
