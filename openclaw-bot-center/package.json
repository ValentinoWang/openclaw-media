    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "simple-icons": "16.28.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
