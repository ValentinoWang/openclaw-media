    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "playwright": "^1.61.1",
    "postcss": "8.5.15",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
