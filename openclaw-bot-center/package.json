{
  "name": "openclaw-bot-center",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "generate:data": "python3 scripts/generateDashboardData.py",
    "generate:capability-match-contract": "python3 scripts/generateCapabilityMatchContract.py",
    "generate:media-business-contract": "python3 scripts/generateMediaBusinessPagesContract.py",
    "validate:media-business-contract": "python3 scripts/generateMediaBusinessPagesContract.py --check",
    "validate:capability-match-contract": "python3 scripts/generateCapabilityMatchContract.py --check",
    "validate:data": "tsx scripts/validateDashboardData.ts",
    "validate:capability-contract": "python3 /home/ubuntu/scripts/quality/check_bot_center_capability_detail_contract.py",
    "validate:presentation-contract": "python3 /home/ubuntu/scripts/quality/check_bot_center_normal_view_presentation_contract.py",
    "validate:content-os-v2-presentation": "tsx scripts/qa/checkContentOsV2Presentation.ts",
    "validate:published-data": "python3 /home/ubuntu/scripts/quality/check_bot_center_published_data_sync.py",
    "qa:capability-matcher-frontend": "npm run validate:capability-match-contract && tsx scripts/qa/checkCapabilityMatcherContract.ts",
    "qa:capability-matcher-panel": "bash scripts/qa/withChromiumSlot.sh -- tsx scripts/qa/checkCapabilityMatcherPanel.ts",
    "qa:graph-layout": "tsx scripts/qa/checkExecutionGraphLayout.ts",
    "qa:prompt-rendering": "npm run qa:graph-layout && bash scripts/qa/withChromiumSlot.sh -- tsx scripts/qa/checkCapabilityPromptRendering.ts",
    "qa:media-role-ia": "tsx scripts/qa/checkMediaRoleIa.ts",
    "qa:media-admin-access-contract": "tsx scripts/qa/checkMediaAdminAccessContract.ts",
    "qa:media-business-foundation": "npm run validate:media-business-contract && npm run qa:media-session-contract && tsx scripts/qa/checkMediaBusinessFoundation.ts",
    "qa:media-design-system-contract": "tsx scripts/qa/checkMediaDesignSystemContract.ts",
    "qa:media-role-screens": "bash scripts/qa/withChromiumSlot.sh -- tsx scripts/qa/captureMediaRolePages.ts",
    "qa:media-web": "bash scripts/qa/withChromiumSlot.sh -- tsx scripts/qa/checkMediaWebChannel.ts",
    "qa:media-registration": "tsx scripts/qa/checkMediaRegistrationPage.ts",
    "qa:media-session-contract": "tsx scripts/qa/checkMediaSessionContract.ts",
    "qa:media-login-contract": "tsx scripts/qa/checkMediaLoginContract.ts",
    "qa:media-web-task-error-contract": "npm run validate:capability-match-contract && tsx scripts/qa/checkMediaWebTaskErrorContract.ts",
    "qa:creator-avatar-cookie-contract": "tsx scripts/qa/checkCreatorAvatarCookieContract.ts",
    "qa:creator-avatar-cookie-production": "bash scripts/qa/withChromiumSlot.sh -- tsx scripts/qa/checkCreatorAvatarCookieProduction.ts",
    "qa:media-release-labels": "tsx scripts/qa/checkMediaReleaseLabels.ts",
    "qa:media-w1": "tsx scripts/qa/checkMediaW1Contract.ts",
    "qa:media-runs-commercial-delivery": "tsx scripts/qa/checkRunsCommercialDeliveryView.ts",
    "qa:media-run-detail-route": "tsx scripts/qa/checkMediaRunDetailRoute.ts",
    "qa:media-run-metadata": "tsx scripts/qa/checkRunMetadataFields.ts",
    "qa:media-readable-fields": "tsx scripts/qa/checkMediaReadableFields.ts",
    "qa:media-assets-thumbnail": "tsx scripts/qa/checkAssetsThumbnailPresentation.ts",
    "qa:media-ordinary-presentation": "tsx scripts/qa/checkMediaOrdinaryPresentation.ts",
    "qa:track-relationship-presentation": "tsx scripts/qa/checkTrackRelationshipPresentation.ts",
    "qa:media-runs-commercial-delivery-release": "tsx scripts/qa/checkCommercialDeliveryRelease.ts",
    "qa:media-organization-document-preview": "tsx scripts/qa/checkOrganizationDocumentPreview.ts",
    "qa:overview-desktop-interactions": "bash scripts/qa/withChromiumSlot.sh -- tsx scripts/qa/checkOverviewDesktopInteractions.ts",
    "qa:overview-artifact-names-production": "bash scripts/qa/withChromiumSlot.sh -- tsx scripts/qa/checkOverviewArtifactNamesProduction.ts",
    "qa:overview-task-confirmation-contract": "tsx scripts/qa/checkOverviewTaskConfirmationContract.ts",
    "qa:overview-task-confirmation-safety": "bash scripts/qa/withChromiumSlot.sh -- tsx scripts/qa/checkOverviewTaskConfirmationSafety.ts",
    "qa:overview-task-confirmation-production": "bash scripts/qa/withChromiumSlot.sh -- tsx scripts/qa/checkOverviewTaskConfirmationProduction.ts",
    "qa:deletion-intent-lifecycle": "bash scripts/qa/withChromiumSlot.sh -- tsx scripts/qa/checkDeletionIntentLifecycle.ts",
    "qa:media-invite-copy": "tsx scripts/qa/checkInvitesClipboard.ts",
    "qa:secure-uuid": "tsx scripts/qa/checkSecureUuid.ts",
    "qa:material-parsing": "tsx scripts/qa/checkMaterialParsing.ts",
    "qa:task-launch": "tsx scripts/qa/checkTaskLaunchDraft.ts",
    "qa:contextual-capability-launches": "tsx scripts/qa/checkContextualCapabilityLaunches.ts",
    "qa:media-recent-task-presentation": "tsx scripts/qa/checkRecentTaskPresentation.ts",
    "qa:confirmation-receipt-expiry": "tsx scripts/qa/checkConfirmationReceiptExpiry.ts",
    "qa:task-workspace-deletion-recovery": "bash scripts/qa/withChromiumSlot.sh -- tsx scripts/qa/checkTaskWorkspaceDeletionRecovery.ts",
    "qa:media-platform-icons": "bash scripts/qa/withChromiumSlot.sh -- tsx scripts/qa/checkMediaPlatformBrandIcons.ts",
    "qa:media-platform-registry": "tsx scripts/quality/checkMediaPlatformRegistry.ts",
    "qa:media-platform-registry-fixtures": "tsx scripts/quality/checkMediaPlatformRegistry.ts --self-test",
    "build": "npm run generate:capability-match-contract && tsc -b && vite build",
    "build:media": "npm run qa:media-login-contract && npm run qa:media-web-task-error-contract && npm run qa:media-registration && npm run qa:contextual-capability-launches && npm run qa:media-design-system-contract && npm run qa:media-ordinary-presentation && npm run qa:media-assets-thumbnail && npm run qa:track-relationship-presentation && npm run qa:media-recent-task-presentation && npm run qa:confirmation-receipt-expiry && npm run qa:task-workspace-deletion-recovery && npm run qa:overview-task-confirmation-contract && npm run qa:deletion-intent-lifecycle && tsc -b tsconfig.media-u12b.json && vite build --config vite.media.config.ts && npm run qa:media-release-labels",
    "build:all": "npm run build && npm run build:media",
    "lint": "oxlint src scripts --ignore-pattern 'dist/**' --ignore-pattern 'dist-media/**'",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@tailwindcss/vite": "^4.3.1",
    "fuse.js": "^7.4.2",
    "lucide-react": "^1.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "simple-icons": "16.28.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
