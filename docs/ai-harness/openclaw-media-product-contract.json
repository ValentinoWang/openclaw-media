    "JobAckRequest": {"type": "object", "required": ["ack_ref", "expected_revision"], "properties": {"ack_ref": {"type": "string"}, "expected_revision": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "JobAckResponse": {"type": "object", "required": ["job"], "properties": {"job": {"$ref": "#/api_schemas/LocalAgentJob"}}, "additionalProperties": false},
    "JobStartRequest": {"type": "object", "required": ["start_ref", "expected_revision"], "properties": {"start_ref": {"type": "string"}, "expected_revision": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "JobStartResponse": {"type": "object", "required": ["job"], "properties": {"job": {"$ref": "#/api_schemas/LocalAgentJob"}}, "additionalProperties": false},
    "JobResultRequest": {"type": "object", "required": ["result_status", "result_refs", "expected_revision"], "properties": {"result_status": {"enum": ["succeeded", "blocked", "failed"]}, "result_refs": {"type": "array", "items": {"type": "string"}}, "artifact_refs": {"type": "array", "items": {"type": "string"}}, "failure_code": {"type": ["string", "null"]}, "expected_revision": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "JobResultResponse": {"type": "object", "required": ["job"], "properties": {"job": {"$ref": "#/api_schemas/LocalAgentJob"}}, "additionalProperties": false},
    "ArchiveCommitRequest": {"type": "object", "required": ["run_id", "manifest", "confirmation_ref"], "properties": {"run_id": {"type": "string"}, "manifest": {"$ref": "#/api_schemas/ArchiveManifest"}, "confirmation_ref": {"type": "string"}}, "additionalProperties": false},
