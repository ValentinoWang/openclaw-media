    "ArchiveListRequest": {"type": "object", "properties": {"cursor": {"type": "string"}, "limit": {"type": "integer", "minimum": 1, "maximum": 100}, "state": {"type": "string"}}, "additionalProperties": false},
    "ArchiveListResponse": {"type": "object", "required": ["archives", "next_cursor"], "properties": {"archives": {"type": "array", "items": {"$ref": "#/api_schemas/ArchiveRecord"}}, "next_cursor": {"type": ["string", "null"]}}, "additionalProperties": false},
    "ArchiveDetailResponse": {"type": "object", "required": ["archive"], "properties": {"archive": {"$ref": "#/api_schemas/ArchiveRecord"}}, "additionalProperties": false},
    "ArchiveDeletePlanResponse": {"type": "object", "required": ["delete_plan_id", "archive_id", "expires_at"], "properties": {"delete_plan_id": {"type": "string"}, "archive_id": {"type": "string"}, "expires_at": {"type": "string", "format": "date-time"}}, "additionalProperties": false},
    "ArchiveDeleteRequest": {"type": "object", "required": ["delete_plan_id", "confirmation_ref", "expected_revision"], "properties": {"delete_plan_id": {"type": "string"}, "confirmation_ref": {"type": "string"}, "expected_revision": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
