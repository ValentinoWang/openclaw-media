{
  "contract_id": "openclaw_media_product_v1",
  "version": 1,
  "release": {
    "platforms": ["macos"],
    "python_requires": ">=3.12,<3.14"
  },
  "api_base": "/openclaw/media/api",
  "web": {
    "local_collaboration": {
      "surfaces": ["/media-agent", "/archives"],
      "media_bytes": "local_only",
      "api_consumption": "generated_client_only"
    }
  },
  "objects": [
    {
      "id": "PipelineDefinition",
      "location": "cloud",
      "id_field": "pipeline_id",
      "references": [
        "CLIRelease"
      ]
    },
    {
      "id": "Device",
      "location": "cloud",
      "id_field": "device_id",
      "references": []
    },
    {
      "id": "LocalAgentJob",
      "location": "cloud",
      "id_field": "job_id",
      "references": [
        "Device",
        "PipelineDefinition",
        "LocalAnalysisRun"
      ]
    },
    {
      "id": "ArchiveRecord",
      "location": "cloud",
      "id_field": "archive_id",
      "references": [
        "LocalAnalysisRun",
        "ArchiveManifest"
      ]
    },
    {
      "id": "CLIRelease",
      "location": "cloud",
      "id_field": "release_id",
      "references": []
    },
    {
      "id": "ProviderConfig",
      "location": "local",
      "id_field": "provider_config_id",
      "references": []
    },
    {
      "id": "LocalWorkspace",
      "location": "local",
      "id_field": "workspace_id",
      "references": []
    },
    {
      "id": "LocalAnalysisRun",
      "location": "local",
      "id_field": "run_id",
      "references": [
        "LocalWorkspace",
        "PipelineDefinition",
        "ProviderConfig"
      ]
    },
    {
      "id": "LocalArtifact",
      "location": "local",
      "id_field": "artifact_id",
      "references": [
        "LocalAnalysisRun"
      ]
    },
    {
      "id": "ArchiveManifest",
      "location": "local",
      "id_field": "manifest_id",
      "references": [
        "LocalAnalysisRun",
        "LocalArtifact"
      ]
    }
  ],
  "state_machines": {
    "MediaProject": [
      "captured",
      "planned",
      "edit_ready",
      "editing",
      "final_ready",
      "published"
    ],
    "MediaWebTask": [
      "queued",
      "awaiting_confirmation",
      "succeeded",
      "pending_manual",
      "failed",
      "cancelled"
    ],
    "LocalAgentJob": [
      "queued",
      "leased",
      "acknowledged",
      "running",
      "succeeded",
      "blocked",
      "failed",
      "expired",
      "cancelled"
    ],
    "LocalAnalysisRun": [
      "created",
      "validating",
      "preprocessing",
      "analyzing",
      "rendering",
      "reviewing",
      "ready_to_archive",
      "succeeded",
      "pending_manual",
      "failed",
      "cancelled"
    ],
    "ArchiveCommit": [
      "draft",
      "committing",
      "verifying",
      "archived",
      "failed",
      "cancelled"
    ],
    "ArchiveRecord": [
      "active",
      "deleting",
      "delete_failed"
    ]
  },
  "routes": [
    {
      "path": "/overview",
      "object_id": "ArchiveRecord"
    },
    {
      "path": "/tracks",
      "object_id": "ArchiveRecord"
    },
    {
      "path": "/assets",
      "object_id": "LocalArtifact"
    },
    {
      "path": "/runs",
      "object_id": "LocalAgentJob"
    },
    {
      "path": "/runs/:runId",
      "object_id": "LocalAgentJob"
    },
    {
      "path": "/publishing",
      "object_id": "ArchiveRecord"
    },
    {
      "path": "/reviews",
      "object_id": "ArchiveRecord"
    },
    {
      "path": "/media-agent",
      "object_id": "LocalWorkspace"
    },
    {
      "path": "/archives",
      "object_id": "ArchiveRecord"
    }
  ],
  "archive_modes": [
    "content",
    "descriptor_only",
    "forbidden"
  ],
  "api_schemas": {
