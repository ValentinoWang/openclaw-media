    "ArchiveReadbackRequest": {"type": "object", "required": ["readback_receipt_ref"], "properties": {"readback_receipt_ref": {"type": "string"}, "observed_refs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "ArchiveReadbackResponse": {"type": "object", "required": ["archive", "verified", "readback_receipt", "hard_deleted"], "properties": {"archive": {"anyOf": [{"$ref": "#/api_schemas/ArchiveRecord"}, {"type": "null"}]}, "verified": {"type": "boolean"}, "readback_receipt": {"$ref": "#/api_schemas/ArchiveReadbackReceipt"}, "hard_deleted": {"type": "boolean"}}, "additionalProperties": false},
    "CLIReleaseCompatibilityRequest": {"type": "object", "required": ["cli_version", "platform", "python_version", "catalog_digest", "api_version"], "properties": {"cli_version": {"type": "string"}, "platform": {"const": "macos"}, "python_version": {"type": "string"}, "catalog_digest": {"type": "string"}, "api_version": {"type": "string"}}, "additionalProperties": false},
    "CLIReleaseCompatibilityResponse": {"type": "object", "required": ["compatible", "min_cli_version", "supported_python", "supported_platforms"], "properties": {"compatible": {"type": "boolean"}, "min_cli_version": {"type": "string"}, "supported_python": {"type": "string"}, "supported_platforms": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "Device": {"type": "object", "required": ["device_id", "state", "device_label", "device_platform", "client_version", "capabilities", "revision", "last_seen_at"], "properties": {"device_id": {"type": "string"}, "state": {"enum": ["paired", "online", "revoked"]}, "device_label": {"type": "string"}, "device_platform": {"const": "macos"}, "client_version": {"type": "string"}, "capabilities": {"type": "array", "items": {"type": "string"}}, "revision": {"type": "integer", "minimum": 0}, "last_seen_at": {"type": ["string", "null"], "format": "date-time"}}, "additionalProperties": false},
