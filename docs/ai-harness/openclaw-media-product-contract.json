    "PipelineListResponse": {"type": "object", "required": ["pipelines", "next_cursor"], "properties": {"pipelines": {"type": "array", "items": {"$ref": "#/api_schemas/PipelineSummary"}}, "next_cursor": {"type": ["string", "null"]}}, "additionalProperties": false},
    "PipelineSummary": {"type": "object", "required": ["pipeline_id", "version", "display_name", "catalog_digest"], "properties": {"pipeline_id": {"type": "string"}, "version": {"type": "string"}, "display_name": {"type": "string"}, "catalog_digest": {"type": "string"}}, "additionalProperties": false},
    "PairCodeCreateRequest": {"type": "object", "required": ["device_label", "expires_in_seconds"], "properties": {"device_label": {"type": "string", "minLength": 1}, "expires_in_seconds": {"type": "integer", "minimum": 60, "maximum": 3600}}, "additionalProperties": false},
    "PairCodeCreateResponse": {"type": "object", "required": ["pair_code", "expires_at"], "properties": {"pair_code": {"type": "string"}, "expires_at": {"type": "string", "format": "date-time"}}, "additionalProperties": false},
    "DevicePairRequest": {"type": "object", "required": ["pair_code", "device_label", "device_platform", "client_version"], "properties": {"pair_code": {"type": "string"}, "device_label": {"type": "string"}, "device_platform": {"const": "macos"}, "client_version": {"type": "string"}}, "additionalProperties": false},
    "DevicePairResponse": {"type": "object", "required": ["device", "device_credential"], "properties": {"device": {"$ref": "#/api_schemas/Device"}, "device_credential": {"type": "string"}}, "additionalProperties": false},
    "DeviceListRequest": {"type": "object", "properties": {"cursor": {"type": "string"}, "limit": {"type": "integer", "minimum": 1, "maximum": 100}}, "additionalProperties": false},
    "DeviceListResponse": {"type": "object", "required": ["devices", "next_cursor"], "properties": {"devices": {"type": "array", "items": {"$ref": "#/api_schemas/Device"}}, "next_cursor": {"type": ["string", "null"]}}, "additionalProperties": false},
    "DeviceHeartbeatRequest": {"type": "object", "required": ["observed_at", "client_version", "api_version", "catalog_digest", "expected_revision"], "properties": {"observed_at": {"type": "string", "format": "date-time"}, "client_version": {"type": "string", "minLength": 1}, "api_version": {"type": "string", "minLength": 1}, "catalog_digest": {"type": "string", "minLength": 1}, "capabilities": {"type": "array", "items": {"type": "string"}}, "expected_revision": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "DeviceHeartbeatResponse": {"type": "object", "required": ["device_id", "accepted_at", "revision", "state", "accepted_client_version", "catalog_digest", "api_compatible", "catalog_compatible", "claimable_job"], "properties": {"device_id": {"type": "string"}, "accepted_at": {"type": "string", "format": "date-time"}, "revision": {"type": "integer", "minimum": 0}, "state": {"enum": ["paired", "online", "revoked"]}, "accepted_client_version": {"type": "string"}, "catalog_digest": {"type": "string"}, "api_compatible": {"type": "boolean"}, "catalog_compatible": {"type": "boolean"}, "claimable_job": {"anyOf": [{"$ref": "#/api_schemas/ClaimableJob"}, {"type": "null"}]}}, "additionalProperties": false},
    "DeviceRevokeRequest": {"type": "object", "required": ["expected_revision"], "properties": {"expected_revision": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "DeviceRevokeResponse": {"type": "object", "required": ["device_id", "revoked_at"], "properties": {"device_id": {"type": "string"}, "revoked_at": {"type": "string", "format": "date-time"}}, "additionalProperties": false},
    "JobCreateRequest": {"type": "object", "required": ["pipeline_id", "pipeline_version", "catalog_digest", "device_id", "input_refs", "output_selection"], "properties": {"pipeline_id": {"type": "string"}, "pipeline_version": {"type": "string"}, "catalog_digest": {"type": "string"}, "device_id": {"type": "string"}, "input_refs": {"type": "array", "items": {"type": "string"}}, "output_selection": {"type": "array", "items": {"type": "string"}}, "confirmation_ref": {"type": "string"}}, "additionalProperties": false},
    "JobCreateResponse": {"type": "object", "required": ["job"], "properties": {"job": {"$ref": "#/api_schemas/LocalAgentJob"}}, "additionalProperties": false},
    "JobListRequest": {"type": "object", "properties": {"cursor": {"type": "string"}, "limit": {"type": "integer", "minimum": 1, "maximum": 100}, "state": {"type": "string"}}, "additionalProperties": false},
    "JobListResponse": {"type": "object", "required": ["jobs", "next_cursor"], "properties": {"jobs": {"type": "array", "items": {"$ref": "#/api_schemas/LocalAgentJob"}}, "next_cursor": {"type": ["string", "null"]}}, "additionalProperties": false},
    "JobDetailResponse": {"type": "object", "required": ["job"], "properties": {"job": {"$ref": "#/api_schemas/LocalAgentJob"}}, "additionalProperties": false},
