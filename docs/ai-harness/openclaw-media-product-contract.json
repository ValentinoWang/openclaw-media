    "ArchiveContent": {"type": "object", "required": ["encoding", "value"], "properties": {"encoding": {"enum": ["utf8", "base64"]}, "value": {"type": "string", "maxLength": 1048576}}, "additionalProperties": false},
    "ArchiveArtifact": {"type": "object", "required": ["ref", "mode", "mime_type", "sha256", "size_bytes", "descriptor", "metadata", "content"], "properties": {"ref": {"type": "string", "minLength": 1}, "mode": {"enum": ["content", "descriptor_only", "forbidden"]}, "mime_type": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 0}, "descriptor": {"type": "boolean"}, "metadata": {"type": "object", "required": ["name", "description", "source_ref"], "properties": {"name": {"type": "string"}, "description": {"type": ["string", "null"]}, "source_ref": {"type": ["string", "null"]}}, "additionalProperties": false}, "content": {"anyOf": [{"$ref": "#/api_schemas/ArchiveContent"}, {"type": "null"}]}}, "allOf": [{"if": {"properties": {"mode": {"const": "content"}}}, "then": {"properties": {"mime_type": {"enum": ["application/json", "text/plain", "text/markdown"]}, "size_bytes": {"maximum": 1048576}, "content": {"$ref": "#/api_schemas/ArchiveContent"}}}}, {"if": {"properties": {"mode": {"const": "descriptor_only"}}}, "then": {"properties": {"content": {"type": "null"}}}}, {"if": {"properties": {"mode": {"const": "forbidden"}}}, "then": {"properties": {"content": {"type": "null"}}}}], "additionalProperties": false},
