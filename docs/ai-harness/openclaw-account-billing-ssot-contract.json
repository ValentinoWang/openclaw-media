    "ledgerKey": "tenant_id+idempotency_key",
    "holdKey": "tenant_id+idempotency_key",
    "redemptionKey": "code_hmac",
    "redemptionBatchKey": "idempotency_key",
    "productMappingKey": "idempotency_key",
    "adminGrantKey": "tenant_id+idempotency_key",
    "refundKey": "fulfillment_id",
    "keyReuseWithDifferentPayload": "idempotency_conflict"
