    "session": ["active", "revoked", "expired"],
    "hold": ["pending", "captured", "released", "pending_manual"],
    "modelOperation": ["pending", "succeeded", "failed", "unknown_reconcile"],
    "upstreamRequest": ["pending", "succeeded", "failed", "unknown_reconcile"],
    "plan": ["draft", "active", "retired"],
    "redemptionCode": ["available", "redeeming", "redeemed", "revoked"],
    "fulfillment": ["pending", "succeeded", "refunded"],
    "registrationPolicy": ["controlled", "open"],
    "admissionBatch": ["active", "disabled"],
    "admissionCode": ["active", "consumed"]
  },
  "transactions": {
    "walletNonNegative": true,
    "ledgerAppendOnly": true,
    "walletProjectionSameTransaction": true,
    "holdBeforeUpstreamCall": true,
    "affiliateEdgeImmutable": true,
    "registrationAtomic": true,
    "admissionCodesAdminReadable": true,
    "affiliateQuotaLocked": true,
    "affiliateCyclesProhibited": true,
    "registrationRewardProhibited": true,
    "priceVersionImmutable": true,
    "redemptionCodeHmacOnly": true,
    "redemptionFinalizationAtomic": true,
    "affiliateRewardRate": "0.1000",
    "affiliateRewardDirectOnly": true,
    "refundDebtExplicit": true,
    "planCatalogFixed": true,
    "productMappingImmutable": true,
    "redemptionExportPrivate": true,
    "adminGrantAtomicAndAudited": true,
    "legacyAdminAdjustmentProhibited": true,
    "purchaseUrlLiandongHttpsOnly": true
