# Copy values into the runtime environment used by OpenClaw, or the repository
# root `.env.local`. Do not commit real secrets.

FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Feishu Bitable URL for the account monitor table.
# Required fields in the table: 账号名称, 平台, 近期作品链接, 启用.
FEISHU_ACCOUNT_MONITOR_URL=

# Feishu Bitable URL for the daily account/post report.
FEISHU_ACCOUNT_REPORT_URL=

# Use 1 in scheduled production runs so Feishu write failures fail loudly.
FEISHU_REQUIRED=1

# Optional repository-default overrides for media-agent rule files and the
# CreatorProfile field contract. Leave unset to use the tracked defaults.
OPENCLAW_MEDIA_AGENT_ROOT=
OPENCLAW_MEDIA_MODEL_CONTRACT_PATH=
