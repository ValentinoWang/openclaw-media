# Content cleaning uses the content_cleaner profile in config/openclaw_bots.json.

MAX_INLINE_SIZE=20971520

DASHSCOPE_API_KEY=
ASR_PROVIDER=dashscope
DASHSCOPE_ASR_MODEL=fun-asr
DASHSCOPE_ASR_MODE=batch
DASHSCOPE_TIMEOUT=14400
DASHSCOPE_POLL_INTERVAL=5

DOWNLOAD_READ_TIMEOUT=120
DOWNLOAD_MAX_SECONDS=180
DOWNLOAD_PREFER_FFMPEG=0
PREFER_LOW_QUALITY=1
VIDEO_RATIO=480p
TOP_COMMENTS_LIMIT=3

NOTION_TOKEN=
NOTION_DATABASE_ID=

PLAYWRIGHT_HEADLESS=1
PLAYWRIGHT_DEBUG=0
COOKIES_PROFILE=Default
PLAYWRIGHT_PROXY_SERVER=http://127.0.0.1:7890

HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
ALL_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,::1

DOUYIN_COOKIES_JSON_PATH=./private/douyin-cookies.json
XIAOHONGSHU_COOKIES_JSON_PATH=./private/xiaohongshu-cookies.json
