{
  "defaults": {},
  "policy": {
    "default_provider": "openclaw_codex",
    "openclaw_runtime_provider": "openclaw_codex"
  },
  "openclaw_runtime": {
    "heartbeat_every": "0m",
    "session_maintenance": {
      "mode": "enforce",
      "prune_after": "14d",
      "reset_archive_retention": "14d"
    },
    "codex_app_server": {
      "command": "codex",
      "args": [
        "app-server",
        "--listen",
        "stdio://"
      ],
      "service_tier": "priority",
      "turn_completion_idle_timeout_ms": 180000,
      "version": "0.147.0"
    }
  },
  "model_tiers": {
    "L": {
      "model": "gpt-5.6-luna",
      "reasoning": "low"
    },
    "A": {
      "model": "gpt-5.6-terra",
      "reasoning": "medium"
    },
    "B": {
      "model": "gpt-5.6-terra",
      "reasoning": "high"
    },
    "C": {
      "model": "gpt-5.6-sol",
      "reasoning": "medium"
    }
  },
  "agent_overrides": {
    "openclaw-maintenance": {
      "model_tier": "C"
    }
  },
  "bots": {
    "main": {
      "provider": "openclaw_codex",
      "agent": "feishu-main",
      "cwd": "${OPENCLAW_AGENTS_ROOT}/main",
      "model_tier": "B"
    },
    "daily": {
      "provider": "openclaw_codex",
      "agent": "feishu-daily",
      "cwd": "${OPENCLAW_AGENTS_ROOT}/daily",
      "model_tier": "A"
    },
    "deepmath": {
      "provider": "openclaw_codex",
      "agent": "deepmath-office",
      "cwd": "${OPENCLAW_AGENTS_ROOT}/deepmath",
      "runtime_config": ".openclaw-deepmath/openclaw.json",
      "model_tier": "A"
    },
    "knowledge": {
      "provider": "openclaw_codex",
      "agent": "feishu-knowledge",
      "cwd": "${OPENCLAW_AGENTS_ROOT}/knowledge",
      "model_tier": "B"
    },
    "media": {
      "provider": "openclaw_codex",
      "agent": "feishu-media",
      "cwd": "${OPENCLAW_AGENTS_ROOT}/media",
      "model_tier": "C"
    },
    "social": {
      "provider": "openclaw_codex",
      "agent": "feishu-social",
      "cwd": "${OPENCLAW_AGENTS_ROOT}/social",
      "model_tier": "B"
    }
  },
  "profiles": {
    "system_guide": {
      "provider": "openclaw_codex",
      "bot": "main",
      "model_tier": "B"
    },
    "knowledge_delegate": {
      "provider": "openclaw_codex",
      "bot": "knowledge",
      "model_tier": "B"
    },
    "transcription_postprocess": {
      "provider": "openclaw_codex",
      "bot": "knowledge",
      "model_tier": "B"
    },
    "media_analysis": {
      "provider": "openclaw_codex",
      "bot": "media",
      "model_tier": "C"
    },
    "media_creation": {
      "provider": "openclaw_codex",
      "bot": "media",
      "model_tier": "C"
    },
    "activity_cleaning": {
      "provider": "openclaw_codex",
      "bot": "media",
      "model_tier": "C",
      "timeout": 300
    },
    "daily_task_extraction": {
      "provider": "openclaw_codex",
      "bot": "daily",
      "model_tier": "A",
      "capacity_max_retries": 2,
      "timeout": 120
    },
    "deepmath_ceo_thinking_structure": {
      "provider": "openclaw_codex",
      "bot": "deepmath",
      "model_tier": "A",
      "capacity_max_retries": 0,
      "timeout": 120
    },
    "deepmath_people_recommendation": {
      "provider": "openclaw_codex",
      "bot": "deepmath",
      "model_tier": "A",
      "capacity_max_retries": 0,
      "timeout": 120
    },
    "daily_hierarchy_records_extraction": {
      "provider": "openclaw_codex",
      "bot": "daily",
      "model_tier": "A",
      "timeout": 300
    },
    "social_vision": {
      "provider": "openclaw_codex",
      "bot": "social",
      "model_tier": "B",
      "timeout": 900
    },
    "content_cleaner": {
      "provider": "openclaw_codex",
      "bot": "main",
      "model_tier": "B",
      "enabled": true,
      "max_chars": 20000,
      "max_tokens": 8192
    }
  },
  "providers": {
    "openclaw_codex": {
      "default_model_tier": "B",
      "base_url": "openclaw://agent",
      "api_key": "codex_auth_file",
      "api_type": "openclaw_agent",
      "timeout": 1800,
      "bin": "openclaw",
      "codex_home": "${OPENCLAW_CODEX_HOME}"
    }
  }
}
